# Copy to .env for local use. Never commit a real key.
FORGENOVAX_API_KEY=replace-with-a-long-random-secret
MODEL=qwen3-coder:30b
CONTEXT_LENGTH=32768
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=20m
OLLAMA_HOST=127.0.0.1:11434
# Comma-separated detected GPU indexes; omit to use every visible NVIDIA GPU.
# FORGENOVAX_CUDA_VISIBLE_DEVICES=0,1
FORGENOVAX_REQUIRE_GPU=1
PROXY_HOST=127.0.0.1
PROXY_PORT=8000
UPSTREAM_TIMEOUT_SECONDS=900
READINESS_TIMEOUT_SECONDS=180
READINESS_CACHE_SECONDS=30
MAX_REQUEST_BYTES=2097152
MAX_RESPONSE_BYTES=16777216

# Optional: private Kaggle Dataset containing model-cache.json and ollama-models/
# FORGENOVAX_MODEL_CACHE_INPUT=/kaggle/input/your-private-cache
OLLAMA_MODELS=/kaggle/working/ollama-models
# Optional: enable benchmarking notebook cell after the model is loaded
FORGENOVAX_RUN_BENCHMARK=0
# Full three-model comparison requires all supported models to be installed.
FORGENOVAX_RUN_MODEL_COMPARISON=0
